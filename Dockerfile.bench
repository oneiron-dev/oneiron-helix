FROM rust:1.85-slim AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
COPY . .
RUN cargo build --test vault_scale_benches --features bench --release \
 && cp $(find target/release/deps/ -name 'vault_scale_benches-*' -type f -executable) /app/vault-bench

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=builder /app/vault-bench /app/vault-bench
ENTRYPOINT ["/app/vault-bench"]
CMD ["--test-threads=1", "--nocapture"]
